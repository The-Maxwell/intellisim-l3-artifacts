$env:MONGO_HOST="localhost:27017";
$env:MONGO_DATABASE="intellisim";
AUTH_SERVER=http://localhost:9090
AUTH_AUDIENCE=
AUTH_ADMIN_ENABLED=false
AUTH_ADMIN_PERMISSION=intellisim:admin
AUTH_PERMISSIONS_CLAIM=permissions
CHATS_GENERATION_TIMEOUT=180s
CHATS_HISTORY_LIMIT=50
# Entity display images are compressed on save (downscaled + re-encoded). Optional.
MODELS_DISPLAY_IMAGE_MAX_DIM=256
MODELS_DISPLAY_IMAGE_MAX_BYTES=262144
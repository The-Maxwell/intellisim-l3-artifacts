# Provider identity (what core's LLMTarget.ProviderUID refers to)
PROVIDER_ID=openai
PROVIDER_NAME=OpenAI

# Core gRPC server — GRPC_PORT must match core's GRPC_SERVER_PORT
GRPC_HOST=localhost
GRPC_PORT=50051

# OpenAI API
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
